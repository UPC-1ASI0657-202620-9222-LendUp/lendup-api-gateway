SERVER_PORT=8090
# Orígenes del frontend separados por coma (patrones permitidos).
CORS_ORIGINS=http://localhost:5173
# Destinos. En Docker local se llega a los servicios del host con host.docker.internal.
MONOLITH_URL=http://host.docker.internal:8080
RESERVATIONS_SERVICE_URL=http://host.docker.internal:8081
PAYMENTS_SERVICE_URL=http://host.docker.internal:8082
NOTIFICATIONS_SERVICE_URL=http://host.docker.internal:8083
# Activar estas URLS sólo cuando Identidad y Catálogo estén corriendo en los puertos indicados.
# Son orígenes (sin /api/v1); si se omiten, sus rutas siguen en el monolito.
# Para evitar choques con Reservas:8081 y Pagos:8082, usar 8085 y 8084 en el HOST.
# IDENTITY_SERVICE_URL=http://host.docker.internal:8085
# CATALOG_SERVICE_URL=http://host.docker.internal:8084
# Reputación conserva su ruta prioritaria; dejar sin configurar para fallback al monolito.
# REPUTATION_SERVICE_URL=http://host.docker.internal:8086
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=20s
